APP_NAME=IFB Library Chat
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=25

DOCUMENTS_DIR=pdfs_ifb
PROCESSED_DIR=data/processed
INGEST_CHUNK_SIZE=500
INGEST_CHUNK_OVERLAP=50
INGEST_DEVICE=auto
CHROMA_DIR=data/chroma
LOGS_DIR=logs
CHROMA_COLLECTION=ifb_tcc_matematica

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
SEARCH_TOP_K=5

# Use "none" enquanto nenhum LLM estiver configurado.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

RAG_RETRIEVAL_TOP_K=8
RAG_MIN_SIMILARITY=0.35
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_QUESTION_CHARS=2000
RAG_DUPLICATE_THRESHOLD=0.92
