APP_NAME=IFB Library Chat
APP_ENV=development
LOG_LEVEL=INFO
# Inclui os tempos de cada etapa do RAG nos logs estruturados.
METRICS_DETAILS_ENABLED=false
# Em produção, a documentação fica desabilitada quando esta opção é omitida.
# API_DOCS_ENABLED=true
# Lista JSON de origens autorizadas; vazia bloqueia acesso cross-origin pelo navegador.
CORS_ALLOWED_ORIGINS=[]
SEARCH_MAX_QUERY_CHARS=2000
API_MAX_TOP_K=50
API_MAX_FILTER_CHARS=500
MAX_UPLOAD_SIZE_MB=25
MAX_REQUEST_SIZE_MB=30
MAX_UPLOAD_FILENAME_CHARS=180
# Gere um valor aleatório forte para habilitar as operações administrativas.
ADMIN_API_TOKEN=

DOCUMENTS_DIR=pdfs_ifb
PROCESSED_DIR=data/processed
INGEST_CHUNK_SIZE=500
INGEST_CHUNK_OVERLAP=50
INGEST_DEVICE=auto
CHROMA_DIR=data/chroma
LOGS_DIR=logs
CHROMA_COLLECTION=ifb_tcc_matematica

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
SEARCH_TOP_K=5

# Use "none" enquanto nenhum LLM estiver configurado.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

RAG_RETRIEVAL_TOP_K=8
RAG_CANDIDATE_POOL_SIZE=24
RAG_MIN_SIMILARITY=0.35
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_QUESTION_CHARS=2000
RAG_DUPLICATE_THRESHOLD=0.92
