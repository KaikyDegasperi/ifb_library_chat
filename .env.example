APP_NAME=IFB Library Chat
APP_ENV=development
LOG_LEVEL=INFO

DOCUMENTS_DIR=pdfs_ifb
PROCESSED_DIR=data/processed
INGEST_CHUNK_SIZE=500
INGEST_CHUNK_OVERLAP=50
INGEST_DEVICE=auto
CHROMA_DIR=data/chroma
LOGS_DIR=logs
CHROMA_COLLECTION=ifb_tcc_matematica

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Use "none" enquanto nenhum LLM estiver configurado.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
