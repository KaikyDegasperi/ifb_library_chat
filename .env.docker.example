# Copie para .env.docker. Nunca grave tokens ou chaves reais neste exemplo.
APP_ENV=development
LOG_LEVEL=INFO
API_DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=[]

# Gere um token forte para habilitar a administração.
ADMIN_API_TOKEN=

MAX_UPLOAD_SIZE_MB=25
MAX_REQUEST_SIZE_MB=30
MAX_UPLOAD_FILENAME_CHARS=180
SEARCH_MAX_QUERY_CHARS=2000
API_MAX_TOP_K=50
API_MAX_FILTER_CHARS=500

INGEST_DEVICE=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
CHROMA_COLLECTION=ifb_tcc_matematica
RETRIEVAL_PROVIDER=bm25
BM25_K1=1.5
BM25_B=0.75
RAG_LEXICAL_PROMOTION_SLOTS=2

# Sem LLM, busca e administração continuam disponíveis e /chat falha de forma controlada.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_TOKENS=256

# Provedor externo compatível com OpenAI:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://provedor.example/v1
# LLM_MODEL=nome-do-modelo
# LLM_API_KEY=defina-somente-no-arquivo-.env.docker-local

# Ollama executado no host (extra_hosts já está configurado no Compose):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434
# LLM_MODEL=qwen2.5:3b
